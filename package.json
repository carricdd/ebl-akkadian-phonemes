{
  "name": "@ebl/akkadian-phonemes",
  "version": "0.3.2",
  "description": "Synthesize Akkadian pronunciation from electronic Babylonian Library (eBL) IPA \u2014 emphatics \u1e6d \u1e63, uvular q, \u1e2b and the three vowel lengths on an Arabic-trained Piper voice (0.3.2, measured), npm module. Neural voices: Piper (VITS) English or Arabic, or OmniVoice; reference engine: espeak-ng (WASM).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "ebl-tts": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scripts/omnivoice_render.py",
    "assets/kristin-reference.wav",
    "TUNING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "fetch-voice": "node scripts/fetch-voice.mjs",
    "demo": "node scripts/gen-demo.mjs",
    "test": "node --test test/*.test.mjs",
    "review-samples": "node scripts/gen-review-samples.mjs"
  },
  "keywords": [
    "akkadian",
    "cuneiform",
    "assyriology",
    "ebl",
    "ipa",
    "phoneme",
    "tts",
    "text-to-speech",
    "piper",
    "vits",
    "onnx",
    "espeak-ng",
    "speech-synthesis",
    "semitic"
  ],
  "author": "CloudRaider / Theosophia",
  "license": "MIT",
  "homepage": "https://github.com/ElectronicBabylonianLiterature",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "espeak-ng": "^1.0.2",
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  }
}
